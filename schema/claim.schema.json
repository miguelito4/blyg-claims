{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miguelito4/blyg-claims/schema/claim.schema.json",
  "title": "Blygger claim block",
  "description": "The JSON inside a fenced `claim` block in a blyg item's content_md. A `json` or unlabeled fence also counts when its object has both `probability` and `resolves_by`.",
  "type": "object",
  "required": [
    "probability",
    "resolves_by"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "The statement being forecast, in one sentence. Recommended."
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "description": "The author's probability that the claim resolves true."
    },
    "resolves_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The last day (ISO date, UTC) on which the claim can resolve."
    },
    "criteria": {
      "type": "string",
      "minLength": 1,
      "description": "How the outcome will be decided, specific enough for someone else to apply. Recommended."
    },
    "check": {
      "$ref": "#/$defs/check",
      "description": "How the outcome is decided. The claim carries the full specification, so it resolves without any catalog or service."
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "description": "Where the claim comes from: a URL or a short note."
    },
    "discussion": {
      "type": "string",
      "format": "uri",
      "description": "Where the claim is being argued."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "commit": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Commit-reveal: sha256 of salt and the hidden claim, revealed in a later version."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "check": {
      "description": "Four kinds of source, by how trust in the answer is established: the protocol, a publisher's versioned statistics, an unversioned web document, or people.",
      "oneOf": [
        {
          "$ref": "#/$defs/blyg"
        },
        {
          "$ref": "#/$defs/data_series"
        },
        {
          "$ref": "#/$defs/web_data"
        },
        {
          "$ref": "#/$defs/judgment"
        }
      ]
    },
    "blyg": {
      "type": "object",
      "description": "Blygger itself: items, claims and pins on blygs. Trust comes from the protocol (pins, content hashes).",
      "required": [
        "oracle",
        "metric",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "blyg"
        },
        "metric": {
          "enum": [
            "blygs_with_claims",
            "item_exists"
          ]
        },
        "among": {
          "description": "\"directory\" (blygger.com/blygs.json) or a list of blyg URLs.",
          "oneOf": [
            {
              "const": "directory"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "item": {
          "type": "string",
          "format": "uri",
          "description": "For item_exists: the item's URL."
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "data_series": {
      "type": "object",
      "description": "A published statistical series, read as it was published on as_of (a fixed data vintage), so every reader sees the same numbers. The provider is a parameter.",
      "required": [
        "oracle",
        "provider",
        "value",
        "as_of",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "data_series"
        },
        "provider": {
          "enum": [
            "fred"
          ],
          "description": "Who publishes the series. FRED (with ALFRED vintages) first; others added as adapters."
        },
        "value": {
          "type": "string",
          "description": "SERIES@DATE, mean(SERIES@START..END), and + - * / with parentheses. Series IDs are the provider's own."
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "web_data": {
      "type": "object",
      "description": "A value in a structured document on the web (JSON now; CSV later). Not versioned by its publisher, so the value is archived when read.",
      "required": [
        "oracle",
        "url",
        "pointer",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "web_data"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON Pointer, e.g. /data/0/value"
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "judgment": {
      "type": "object",
      "description": "People read the evidence and decide. Shown as 'resolves by judgment'.",
      "required": [
        "oracle",
        "by"
      ],
      "properties": {
        "oracle": {
          "const": "judgment"
        },
        "by": {
          "description": "\"author\" or a list of blyg URLs whose resolutions count.",
          "oneOf": [
            {
              "const": "author"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          ]
        },
        "evidence": {
          "type": "string",
          "description": "Where to look, e.g. a URL to archive on the date."
        }
      }
    }
  }
}
