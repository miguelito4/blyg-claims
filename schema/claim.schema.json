{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miguelito4/blyg-claims/schema/claim.schema.json",
  "title": "Blygger claim block",
  "description": "The JSON inside a fenced `claim` block in a blyg item's content_md. A `json` or unlabeled fence also counts when its object has `resolves_by` and either `probability` or `shape`.",
  "type": "object",
  "required": [
    "resolves_by"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "The statement being forecast, in one sentence. Recommended."
    },
    "shape": {
      "enum": [
        "binary",
        "choice",
        "quantity",
        "record"
      ],
      "description": "binary: yes or no. choice: from a list (one, set or order). quantity: how much. record: just record it, never scored. Absent with a probability means binary."
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "description": "The author's probability that the claim resolves true."
    },
    "pick": {
      "enum": [
        "one",
        "set",
        "order"
      ],
      "description": "choice: pick the winner, pick which ones make it, or put the top ones in order."
    },
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "description": "choice: the outcomes, in the writer's order. Percentages optional (never for order): for one they add to 1, for set to `size`."
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "description": "choice: how many make it (set) or how many are ranked (order)."
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "quantity: [low, high]."
    },
    "confidence": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "description": "quantity: how sure the true value lands in the range."
    },
    "unit": {
      "type": "string"
    },
    "resolves_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The last day (ISO date, UTC) on which the claim can resolve."
    },
    "criteria": {
      "type": "string",
      "minLength": 1,
      "description": "How the outcome will be decided, specific enough for someone else to apply. Recommended."
    },
    "check": {
      "$ref": "#/$defs/check",
      "description": "How the outcome is decided. The claim carries the full specification, so it resolves without any catalog or service."
    },
    "voids_if": {
      "type": "string",
      "minLength": 1,
      "description": "Written before the outcome is known: what would cancel the claim. Void claims are not scored."
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "description": "Where the claim comes from: a URL or a short note."
    },
    "discussion": {
      "type": "string",
      "format": "uri",
      "description": "Where the claim is being argued."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "commit": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Commit-reveal: sha256 of salt and the hidden claim, revealed in a later version."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "shape"
          ]
        }
      },
      "then": {
        "required": [
          "probability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "shape": {
            "const": "binary"
          }
        },
        "required": [
          "shape"
        ]
      },
      "then": {
        "required": [
          "probability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "shape": {
            "const": "choice"
          }
        },
        "required": [
          "shape"
        ]
      },
      "then": {
        "required": [
          "pick",
          "outcomes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "shape": {
            "const": "quantity"
          }
        },
        "required": [
          "shape"
        ]
      },
      "then": {
        "required": [
          "range",
          "confidence"
        ]
      }
    }
  ],
  "$defs": {
    "check": {
      "description": "Five kinds of source, by where trust in the answer comes from: the protocol, a publisher's versioned statistics, the authority that keeps a record, an unversioned web document, or people.",
      "oneOf": [
        {
          "$ref": "#/$defs/blyg"
        },
        {
          "$ref": "#/$defs/data_series"
        },
        {
          "$ref": "#/$defs/record"
        },
        {
          "$ref": "#/$defs/web_data"
        },
        {
          "$ref": "#/$defs/judgment"
        }
      ]
    },
    "blyg": {
      "type": "object",
      "description": "Blygger itself: items, claims and pins on blygs. Trust comes from the protocol (pins, content hashes).",
      "required": [
        "oracle",
        "metric",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "blyg"
        },
        "metric": {
          "enum": [
            "blygs_with_claims",
            "item_exists"
          ]
        },
        "among": {
          "description": "\"directory\" (blygger.com/blygs.json) or a list of blyg URLs.",
          "oneOf": [
            {
              "const": "directory"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "item": {
          "type": "string",
          "format": "uri",
          "description": "For item_exists: the item's URL."
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "data_series": {
      "type": "object",
      "description": "A published statistical series, read as it was published on as_of (a fixed data vintage), so every reader sees the same numbers. The provider is a parameter.",
      "required": [
        "oracle",
        "provider",
        "value",
        "as_of",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "data_series"
        },
        "provider": {
          "enum": [
            "fred",
            "worldbank",
            "owid",
            "bis"
          ],
          "description": "Who publishes the series: FRED/ALFRED, World Bank, Our World in Data, Bank for International Settlements."
        },
        "value": {
          "type": "string",
          "description": "SERIES@DATE, mean(SERIES@START..END), and + - * / with parentheses. Series IDs are the provider's own."
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "record": {
      "type": "object",
      "description": "An event of record kept by an authority: a bill's status, a filing, a paper, a ruling.",
      "required": [
        "oracle",
        "registry",
        "id",
        "event"
      ],
      "properties": {
        "oracle": {
          "const": "record"
        },
        "registry": {
          "enum": [
            "congress",
            "sec",
            "arxiv",
            "courtlistener",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The record's own identifier or URL."
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "description": "What has to appear in the record, e.g. \"became law\"."
        }
      }
    },
    "web_data": {
      "type": "object",
      "description": "A value in a structured document on the web (JSON now; CSV later). Not versioned by its publisher, so the value is archived when read.",
      "required": [
        "oracle",
        "url",
        "pointer",
        "op",
        "threshold"
      ],
      "properties": {
        "oracle": {
          "const": "web_data"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON Pointer, e.g. /data/0/value"
        },
        "op": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!="
          ]
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "judgment": {
      "type": "object",
      "description": "People read the evidence and decide. Shown as 'resolves by judgment'.",
      "required": [
        "oracle",
        "by"
      ],
      "properties": {
        "oracle": {
          "const": "judgment"
        },
        "by": {
          "description": "\"author\" or a list of blyg URLs whose resolutions count.",
          "oneOf": [
            {
              "const": "author"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          ]
        },
        "evidence": {
          "type": "string",
          "description": "Where to look, e.g. a URL to archive on the date."
        }
      }
    }
  }
}
